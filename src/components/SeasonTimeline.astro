---
// Avancement de la Compétition : « Journée 4 sur 6 », frise animée des journées, et matchs prévus de la journée choisie.
import TeamLogo from './TeamLogo.astro';
import { matchUrl, team, timeParis } from '../lib/data';
import { hasTableauFinal } from '../lib/finals';
import { progressFor } from '../lib/journees';
import type { StandingGroup } from '../lib/types';

interface Props { slug: string; groups: StandingGroup[] }
const { slug, groups } = Astro.props;
const p = progressFor(slug, groups);
const finals = hasTableauFinal(slug, groups);

const fMonth = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', month: 'short' });
const fDay = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', day: 'numeric', month: 'short' });
const month = (iso: string | null) => (iso ? fMonth.format(new Date(iso)).replace('.', '') : null);
// Peu de journées : la date sous chaque case. Beaucoup (Top 14) : seulement le mois, au changement de mois.
const few = (p?.total ?? 0) <= 8;
const under = p
  ? p.journees.map((j, i) => {
      if (few) return j.start ? fDay.format(new Date(j.start)) : '';
      const m = month(j.start);
      return m && m !== month(p.journees[i - 1]?.start ?? null) ? m : '';
    })
  : [];
// Position des étiquettes sous la frise (en % de la largeur), alignées à droite en fin de frise pour ne pas déborder.
const cells = (p?.total ?? 0) + (finals ? 1 : 0);
const labelStyle = (i: number) => (i / cells > 0.8 ? `right:${((cells - i - 1) / cells) * 100}%;text-align:right` : `left:${(i / cells) * 100}%`);
const fWd = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', weekday: 'short', day: 'numeric' });
// ESPN met minuit UTC quand l'heure du coup d'envoi n'est pas encore fixée.
const kickoff = (iso: string) => (/T00:00(:00(\.000)?)?Z$/.test(iso) ? 'à fixer' : timeParis(iso));
const stateLabel = { done: 'jouée', live: 'en cours', next: 'prochaine', todo: 'à venir' } as const;
---
{p && (
  <section class="tl" data-tl data-anim style={`--n:${p.total + (finals ? 1 : 0)}`}>
    <p class="count"><strong>{p.label}</strong></p>
    <div class="frise" role="tablist" aria-label="Journées">
      {p.journees.map((j, i) => (
        <button
          type="button"
          role="tab"
          class:list={['j', j.state, j.n === p.focus && 'sel']}
          data-j={j.n}
          aria-selected={j.n === p.focus ? 'true' : 'false'}
          aria-label={`Journée ${j.n}, ${stateLabel[j.state]}`}
          style={`--i:${i}`}
        >
          {few && <span class="jn">{j.n}</span>}
        </button>
      ))}
      {finals && <a class="j finals" href={`#tf-${slug}`} style={`--i:${p.total}`} aria-label="Phases finales : voir le Tableau final">★</a>}
    </div>
    <div class="under" aria-hidden="true">
      {under.map((u, i) => u && <span style={labelStyle(i)}>{u}</span>)}
      {finals && few && <span class="fin" style={labelStyle(cells - 1)}>Finales</span>}
    </div>

    {p.journees.map((j) => (
      <div class="jpanel" data-jpanel={j.n} hidden={j.n !== p.focus}>
        <p class="small muted jt">Journée {j.n} · {stateLabel[j.state]}</p>
        {j.matches.length === 0 ? (
          <p class="small muted">Matchs joués avant le début de la saison suivie : pas de détail ici.</p>
        ) : (
          <div class="jm">
            {j.matches.map((m, k) => {
              const done = m.status === 'final';
              return (
                <a class:list={['mm', done && 'done']} href={matchUrl(m.id)} data-teams={`${m.home.teamId} ${m.away.teamId}`} style={`--k:${k}`}>
                  <span class="side"><TeamLogo team={team(m.home.teamId)} /><span class="c">{team(m.home.teamId).short}</span></span>
                  <span class="mid">{done ? <strong>{m.home.score}–{m.away.score}</strong> : <span>{fWd.format(new Date(m.date))}<br />{kickoff(m.date)}</span>}</span>
                  <span class="side r"><span class="c">{team(m.away.teamId).short}</span><TeamLogo team={team(m.away.teamId)} /></span>
                </a>
              );
            })}
          </div>
        )}
      </div>
    ))}
  </section>
)}

<style>
  .tl { margin: 4px 0 14px; }
  .count { margin: 0 0 8px; font-size: .95rem; }
  .frise { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 3px; }
  .j {
    height: 26px; border-radius: 6px; border: 1.5px solid var(--border); background: var(--surface); padding: 0; cursor: pointer;
    display: grid; place-items: center; font: inherit; font-size: .7rem; font-weight: 700; color: var(--muted); text-decoration: none; min-width: 0;
  }
  .j.done { background: var(--win); border-color: var(--win); color: var(--accent-contrast); }
  .j.live { background: color-mix(in srgb, var(--win) 45%, var(--surface)); border-color: var(--win); color: var(--text); }
  .j.next { border-color: var(--win); border-style: dashed; color: var(--text); }
  .j.sel { outline: 2px solid var(--text); outline-offset: 1px; }
  .j.finals { background: color-mix(in srgb, var(--gold) 18%, var(--surface)); border-color: var(--gold); color: var(--gold); font-size: .85rem; }
  .under { position: relative; height: 14px; margin-top: 3px; font-size: .64rem; color: var(--muted); white-space: nowrap; }
  .under span { position: absolute; top: 0; }
  .under .fin { color: var(--gold); font-weight: 700; }

  .jpanel { margin-top: 10px; }
  .jt { margin: 0 0 6px; }
  .jm { display: grid; grid-template-columns: repeat(auto-fill, minmax(165px, 1fr)); gap: 6px; }
  .mm { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 4px; padding: 6px 8px; border-radius: 10px; background: var(--surface); border: 1px solid var(--border); color: inherit; text-decoration: none; }
  .mm.fav { box-shadow: inset 0 0 0 2px var(--accent); background: var(--accent-soft); }
  .side { display: flex; align-items: center; gap: 5px; min-width: 0; }
  .side.r { justify-content: flex-end; }
  .side :global(.logo) { width: 22px !important; height: 22px !important; }
  .tl :global(.logo-ph) { font-size: 0 !important; background: var(--border); }
  .c { font-size: .76rem; font-weight: 700; }
  .mid { font-size: .66rem; color: var(--muted); text-align: center; line-height: 1.15; white-space: nowrap; }
  .mm.done .mid { font-size: .8rem; color: var(--text); }

  /* Animation : la frise se remplit case par case, la journée en cours pulse, les matchs arrivent. */
  @media (prefers-reduced-motion: no-preference) {
    .tl:global(.armed):not(:global(.play)) :is(.j, .jm) { opacity: 0; }
    .tl:global(.play) .j { animation: fill .35s cubic-bezier(.3, 1.5, .5, 1) both; animation-delay: calc(var(--i) * min(60ms, 900ms / var(--n))); }
    .tl:global(.play) .j.live, .tl:global(.play) .j.next { animation: fill .35s cubic-bezier(.3, 1.5, .5, 1) both calc(var(--i) * min(60ms, 900ms / var(--n))), pulse 1.6s ease-in-out 1.2s infinite; }
    .tl:global(.play) .j.finals { animation: fill .35s both calc(var(--i) * min(60ms, 900ms / var(--n))), shine 1.6s ease-in-out 1.4s 2; }
    .tl:global(.play) .mm { animation: rise .35s ease-out both; animation-delay: calc(1s + var(--k) * 70ms); }
    .tl:global(.picked) .mm { animation-delay: calc(var(--k) * 50ms); }
  }
  @keyframes fill { from { transform: scaleY(.2); opacity: 0; } }
  @keyframes pulse { 50% { box-shadow: 0 0 0 4px color-mix(in srgb, var(--win) 30%, transparent); } }
  @keyframes shine { 50% { box-shadow: 0 0 0 4px color-mix(in srgb, var(--gold) 35%, transparent); } }
  @keyframes rise { from { opacity: 0; transform: translateY(6px); } }
</style>
