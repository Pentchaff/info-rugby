---
import Layout from '../../layouts/Layout.astro';
import { STAT_LABELS, age, cleanTeamLabel, competitionBySlug, dayShortParis, matchById, matchUrl, meta, playerPosition, playerTeams, players, seasonStats, team, teamUrl } from '../../lib/data';
import type { ParcoursEntry, Player } from '../../lib/types';
import { METRICS, MIN_MATCHES, compare, formatMetric, highlights, positionPlural, ratios } from '../../lib/playerStats';

export function getStaticPaths() {
  return Object.values(players).filter((p) => p.appearances.some((a) => matchById.has(a.matchId))).map((p) => ({ params: { id: p.id }, props: { player: p } }));
}
const { player: p } = Astro.props as { player: Player };
const { club, nation } = playerTeams(p);
const a = age(p.birthDate);
const pos = playerPosition(p);
const s = seasonStats(p);
const advanced = Object.entries(s.advanced).filter(([k]) => STAT_LABELS[k]);
const seasonLabel = meta.season.label || '';

// Parcours (frise)
const thisYear = new Date().getFullYear();
const all = (p.wikidata?.parcours ?? []).map((e) => {
  const c = cleanTeamLabel(e.team);
  return { ...e, team: c.name, national: e.national || c.national };
});
const dated = all.filter((e) => e.start !== null || e.end !== null).sort((a, b) => (a.start ?? a.end ?? 0) - (b.start ?? b.end ?? 0));
const undated = all.filter((e) => e.start === null && e.end === null);
// Club actuel absent de Wikidata : on l'ajoute d'après les feuilles de match.
const words = (x: string) => x.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').split(/[^a-z0-9]+/).filter((w) => w.length > 3);
if (club && all.length && !all.some((e) => words(e.team).some((w) => words(`${club.name} ${club.espnName}`).includes(w)))) {
  undated.push({ team: `${club.name} (club actuel)`, start: null, end: null, national: false });
}
const lanes = { clubs: dated.filter((e) => !e.national), nations: dated.filter((e) => e.national) };
const minY = Math.min(...dated.map((e) => e.start ?? e.end ?? thisYear), thisYear - 1);
const maxY = thisYear + 1;
const span = Math.max(1, maxY - minY);
const pct = (y: number) => ((y - minY) / span) * 100;
const fmtSpan = (e: ParcoursEntry) => `${e.start ?? '?'} – ${e.end ?? (e.start ? "auj." : '?')}`;
const hasParcours = all.length > 0;
const currentClub = club?.name ?? team(p.appearances.at(-1)?.teamId ?? '').name;

const apps = p.appearances.filter((x) => matchById.has(x.matchId)).reverse();

// Ratios et comparaison au poste
const r = ratios(p);
const cards = METRICS.map((m) => ({ m, v: r[m.key] ?? null, c: compare(p, m, r[m.key] ?? null) })).filter((x) => x.v !== null && !(x.m.onlyNonZero && x.v === 0));
const brief = highlights(p);
const minutesTotal = apps.reduce((t, ap) => t + (ap.minutes ?? 0), 0);
const kicks = apps.reduce((t, ap) => ({ c: t.c + (ap.conversions ?? 0), p: t.p + (ap.penalties ?? 0), d: t.d + (ap.drops ?? 0) }), { c: 0, p: 0, d: 0 });
const cardCount = apps.reduce((t, ap) => ({ y: t.y + (ap.yellow ?? 0), r: t.r + (ap.red ?? 0) }), { y: 0, r: 0 });
const smallSample = apps.length < MIN_MATCHES;
---
<Layout title={p.name}>
  <section class="head">
    {p.headshot ? <img class="photo" src={p.headshot} alt="" width="84" height="84" /> : <div class="photo ph">{p.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}</div>}
    <div>
      <h1>{p.name}</h1>
      <p class="muted">{[pos, a !== null ? `${a} ans` : null].filter(Boolean).join(' · ')}</p>
      <p class="small">
        {club && <a class="link" href={teamUrl(club.id)}>{club.name}</a>}
        {club && nation && ' · '}
        {nation && <a class="link" href={teamUrl(nation.id)}>{nation.name}</a>}
      </p>
    </div>
  </section>

  {brief.length > 0 && (
    <section class="card pad brief">
      <p class="badge" style="margin:0 0 6px">En bref</p>
      <ul>{brief.map((b) => <li>{b}</li>)}</ul>
    </section>
  )}

  <h2>Parcours</h2>
  <section class="card pad">
    {!hasParcours && (
      <div class="tl-row">
        <div class="tl-label"><strong>{currentClub}</strong> <span class="muted">saison {seasonLabel}</span></div>
        <div class="track"><span class="bar now" style="left:0;width:100%"></span></div>
      </div>
    )}
    {(['clubs', 'nations'] as const).map((k) => lanes[k].length > 0 && (
      <>
        <div class="lane-label">{k === 'clubs' ? 'Clubs' : 'Sélections'}</div>
        {lanes[k].map((e) => {
          const st = e.start ?? e.end ?? thisYear;
          const en = e.end ?? (e.start ? maxY : st + 1);
          return (
            <div class="tl-row">
              <div class="tl-label"><strong>{e.team}</strong> <span class="muted">{fmtSpan(e)}</span></div>
              <div class="track"><span class:list={['bar', k === 'nations' && 'nat']} style={`left:${pct(st)}%;width:${Math.max(pct(en) - pct(st), 2)}%`}></span></div>
            </div>
          );
        })}
      </>
    ))}
    {dated.length > 0 && <div class="axis"><span style="left:0">{minY}</span><span style="right:0">{maxY - 1}</span></div>}
    {undated.length > 0 && (
      <>
        <div class="lane-label">{dated.length ? 'Autres équipes (dates inconnues)' : 'Équipes'}</div>
        <div class="chips wrap">{undated.map((e) => <span class="chip">{e.team}</span>)}</div>
      </>
    )}
    {p.wikidata?.qid && <p class="muted small src">Source : <a class="link" href={`https://www.wikidata.org/wiki/${p.wikidata.qid}`} target="_blank" rel="noopener">Wikidata</a></p>}
  </section>

  <h2>Saison {seasonLabel}</h2>
  <section class="tiles">
    <div class="tile card"><b>{s.matches}</b><span>Matchs</span></div>
    <div class="tile card"><b>{s.starts}</b><span>Titularisations</span></div>
    <div class="tile card"><b>{s.tries}</b><span>Essais</span></div>
    <div class="tile card"><b>{s.points}</b><span>Points</span></div>
    {minutesTotal > 0 && <div class="tile card"><b>{minutesTotal}</b><span>Minutes jouées</span></div>}
    {kicks.c + kicks.p + kicks.d > 0 && <div class="tile card"><b>{kicks.c} / {kicks.p}{kicks.d ? ` / ${kicks.d}` : ''}</b><span>Transfo. / pénalités{kicks.d ? ' / drops' : ''}</span></div>}
    {cardCount.y + cardCount.r > 0 && <div class="tile card"><b>{cardCount.y ? `${cardCount.y} 🟨` : ''} {cardCount.r ? `${cardCount.r} 🟥` : ''}</b><span>Cartons</span></div>}
    {advanced.map(([k, v]) => <div class="tile card"><b>{Math.round(v)}</b><span>{STAT_LABELS[k]}</span></div>)}
  </section>

  {cards.length > 0 && (
    <>
      <h2>Ratios et comparaison</h2>
      <p class="muted small">
        {pos ? `Comparé aux ${positionPlural(pos)} ayant joué au moins ${MIN_MATCHES} matchs cette saison, toutes compétitions suivies confondues.` : 'Poste inconnu : pas de comparaison possible.'}
        {smallSample && ' Moins de 3 matchs joués : à prendre avec prudence.'}
      </p>
      <section class="ratios">
        {cards.map(({ m, v, c }) => (
          <div class="ratio card">
            <div class="r-top">
              <span class="r-label">{m.label}</span>
              <b class="r-val">{formatMetric(m, v!)}</b>
            </div>
            {c ? (
              <>
                <p class:list={['so', c.tone]}>{c.sentence}</p>
                <div class="scale" title={`${c.rank}e sur ${c.of}`}>
                  <span class="avg" style={`left:${100 - ((c.avgRank - 1) / Math.max(1, c.of - 1)) * 100}%`} title="Moyenne du poste"></span>
                  <span class:list={['pt', c.tone]} style={`left:${Math.max(2, Math.min(98, 100 - ((c.rank - 1) / Math.max(1, c.of - 1)) * 100))}%`}></span>
                </div>
                <p class="muted r-rank">{c.rank === 1 ? '1er' : `${c.rank}e`} sur {c.of} · moyenne {formatMetric(m, c.avg)} (trait) · à droite = meilleur</p>
              </>
            ) : <p class="muted so">Pas assez de joueurs à ce poste pour comparer.</p>}
            <details><summary class="muted">Comment c'est calculé ?</summary><p class="muted">{m.help}</p></details>
          </div>
        ))}
      </section>
    </>
  )}

  <h2>Matchs de la saison</h2>
  <section class="card scroll-x">
    <table>
      <thead><tr><th>Match</th><th>Rôle</th><th>Min</th><th>Essais</th><th>Pts</th></tr></thead>
      <tbody>
        {apps.map((ap) => {
          const m = matchById.get(ap.matchId);
          if (!m) return null;
          const opp = team(m.home.teamId === ap.teamId ? m.away.teamId : m.home.teamId);
          return (
            <tr>
              <td>
                <a class="link" href={matchUrl(m.id)}>{m.home.teamId === ap.teamId ? 'vs' : '@'} {opp.name}</a>
                <div class="muted small">{dayShortParis(m.date)} · {competitionBySlug.get(m.competition)?.name} · {m.home.score}-{m.away.score}</div>
              </td>
              <td class="muted">{ap.starter ? `Titulaire${ap.jersey ? ` (${ap.jersey})` : ''}` : 'Remplaçant'}</td>
              <td class="muted">{typeof ap.minutes === 'number' ? `${ap.minutes}'` : ''}</td>
              <td>{ap.tries || ''}</td>
              <td>{ap.points || ''}{ap.yellow ? ' 🟨' : ''}{ap.red ? ' 🟥' : ''}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </section>
</Layout>

<style>
  .head { display: flex; gap: 14px; align-items: center; margin: 6px 0; }
  .head p { margin: 2px 0; }
  .photo { width: 84px; height: 84px; border-radius: 50%; object-fit: cover; background: var(--surface-2); flex: none; }
  .ph { display: grid; place-items: center; font-weight: 800; font-size: 1.4rem; color: var(--muted); }
  .lane-label { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin: 10px 0 6px; }
  .lane-label:first-child { margin-top: 0; }
  .tl-row { margin-bottom: 9px; }
  .tl-label { font-size: .88rem; display: flex; justify-content: space-between; gap: 8px; }
  .tl-label strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tl-label .muted { white-space: nowrap; font-size: .8rem; }
  .track { position: relative; height: 8px; margin-top: 4px; background: var(--surface-2); border-radius: 99px; }
  .bar { position: absolute; top: 0; bottom: 0; border-radius: 99px; background: var(--accent); }
  .bar.nat { background: var(--gold); }
  .axis { position: relative; height: 16px; font-size: .7rem; color: var(--muted); }
  .axis span { position: absolute; }
  .chips.wrap { flex-wrap: wrap; }
  .chip { font-weight: 500; }
  .src { margin: 10px 0 0; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 8px; }
  .tile { padding: 12px 14px; display: flex; flex-direction: column; }
  .tile b { font-size: 1.5rem; font-variant-numeric: tabular-nums; }
  .tile span { color: var(--muted); font-size: .8rem; }
  td:nth-child(2) { font-size: .8rem; }
  .brief { margin-top: 14px; border-left: 4px solid var(--accent); }
  .brief ul { margin: 0; padding-left: 18px; }
  .brief li { margin: 4px 0; font-size: .92rem; }
  .ratios { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px; }
  .ratio { padding: 12px 14px; }
  .r-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .r-label { font-size: .82rem; color: var(--muted); font-weight: 600; }
  .r-val { font-size: 1.35rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .so { margin: 4px 0 8px; font-weight: 700; font-size: .9rem; }
  .so.good { color: var(--win); }
  .so.bad { color: var(--live); }
  .scale { position: relative; height: 6px; border-radius: 99px; background: linear-gradient(90deg, color-mix(in srgb, var(--live) 35%, var(--surface-2)), var(--surface-2) 50%, color-mix(in srgb, var(--win) 35%, var(--surface-2))); }
  .scale .avg { position: absolute; top: -3px; width: 2px; height: 12px; background: var(--muted); transform: translateX(-1px); }
  .scale .pt { position: absolute; top: 50%; width: 14px; height: 14px; border-radius: 50%; transform: translate(-50%, -50%); background: var(--text); border: 2px solid var(--surface); }
  .scale .pt.good { background: var(--win); }
  .scale .pt.bad { background: var(--live); }
  .r-rank { font-size: .75rem; margin: 8px 0 0; }
  .ratio details { margin-top: 6px; font-size: .75rem; }
  .ratio details summary { font-weight: 500; }
  .ratio details p { margin: 4px 0 0; }
</style>
