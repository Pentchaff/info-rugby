---
// Page de test provisoire : le navigateur peut-il lire les scores ESPN directement ? (préalable au Score en direct)
import Layout from '../layouts/Layout.astro';
import { competitions } from '../lib/data';
import { meta } from '../lib/data';

const leagues = competitions
  .map((c) => ({ name: c.name, id: c.espnId || meta.leagues[c.slug]?.espnId || '' }))
  .filter((l) => l.id);
---
<Layout title="Test du direct">
  <h1>Test du direct</h1>
  <p class="muted small">Vérifie si ce téléphone peut lire les scores ESPN sans passer par GitHub. Page provisoire.</p>
  <div class="card pad">
    <p id="verdict"><strong>Test en cours…</strong></p>
    <ul id="lines" class="small"></ul>
  </div>
  <script type="application/json" id="leagues" set:html={JSON.stringify(leagues)} />
</Layout>

<script>
  const leagues = JSON.parse(document.getElementById('leagues')!.textContent || '[]') as { name: string; id: string }[];
  const lines = document.getElementById('lines')!;
  const verdict = document.getElementById('verdict')!;
  const add = (html: string) => {
    const li = document.createElement('li');
    li.innerHTML = html;
    lines.appendChild(li);
  };
  (async () => {
    let ok = 0;
    for (const l of leagues) {
      const t0 = performance.now();
      try {
        const r = await fetch(`https://site.api.espn.com/apis/site/v2/sports/rugby/${l.id}/scoreboard`, { cache: 'no-store' });
        const j = await r.json();
        const events = (j?.events ?? []) as any[];
        const live = events.filter((e) => e?.status?.type?.state === 'in');
        const ms = Math.round(performance.now() - t0);
        ok++;
        const ex = live[0] ?? events[0];
        const exTxt = ex ? ` — ex. ${ex.shortName ?? ex.name ?? ''} : ${ex?.status?.type?.shortDetail ?? ''}` : '';
        add(`✅ ${l.name} : ${events.length} match(s), ${live.length} en cours (${ms} ms)${exTxt}`);
      } catch (e) {
        add(`❌ ${l.name} : bloqué (${(e as Error).message})`);
      }
    }
    verdict.innerHTML = ok === leagues.length
      ? '<strong>✅ Ça marche : le téléphone lit ESPN directement.</strong>'
      : ok > 0
        ? '<strong>⚠️ Ça marche en partie.</strong>'
        : '<strong>❌ Bloqué : il faudra un relais.</strong>';
  })();
</script>
